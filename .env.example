# The deterministic provider works without any API key.
WORKFLOW_AI_LLM_PROVIDER=deterministic

# Optional AI providers. Install the matching extra first:
#   uv sync --extra openai
#   uv sync --extra anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WORKFLOW_AI_OPENAI_MODEL=gpt-5.5
WORKFLOW_AI_ANTHROPIC_MODEL=claude-sonnet-5
WORKFLOW_AI_LLM_MAX_OUTPUT_TOKENS=4096

# Local paths are resolved from WORKFLOW_AI_WORKSPACE_ROOT.
WORKFLOW_AI_WORKSPACE_ROOT=.
WORKFLOW_AI_VAULT_PATH=vault
WORKFLOW_AI_RUNTIME_PATH=.workflow-ai

# Live network dispatch is disabled by default. Filesystem export remains available.
WORKFLOW_AI_LIVE_DISPATCH_ENABLED=false
WORKFLOW_AI_WEBHOOK_URL=

# Safety and workload limits.
WORKFLOW_AI_MAX_SOURCE_CHARS=200000
WORKFLOW_AI_API_KEY=
